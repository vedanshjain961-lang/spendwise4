<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories - SpendWise</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm border-bottom sticky-top">
        <div class="container-fluid px-4"><a class="navbar-brand fw-bold text-primary d-flex align-items-center" href="/dashboard"><i class="bi bi-wallet2 fs-4 me-2 text-gold"></i> SpendWise</a></div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse border-end" id="sidebarMenu">
                <div class="position-sticky pt-4 px-3">
                    <ul class="nav flex-column gap-1">
                        <li class="nav-item"><a class="nav-link" href="/dashboard"><i class="bi bi-grid-1x2-fill me-2"></i> Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" href="/transactions"><i class="bi bi-list-columns-reverse me-2"></i> Transactions</a></li>
                        <li class="nav-item"><a class="nav-link" href="/budgets"><i class="bi bi-pie-chart-fill me-2"></i> Budgets</a></li>
                        <li class="nav-item"><a class="nav-link" href="/savings"><i class="bi bi-piggy-bank-fill me-2"></i> Savings Goals</a></li>
                        <li class="nav-item"><a class="nav-link" href="/subscriptions"><i class="bi bi-arrow-repeat me-2"></i> Subscriptions</a></li>
                        <li class="nav-item"><a class="nav-link" href="/split-bills"><i class="bi bi-people-fill me-2"></i> Bill Splitter</a></li>
                        <li class="nav-item"><a class="nav-link" href="/debts"><i class="bi bi-bank me-2"></i> Debt Tracker</a></li>
                        <li class="nav-item"><a class="nav-link active" href="/categories"><i class="bi bi-tags-fill me-2"></i> Categories</a></li>
                        <li class="nav-item"><a class="nav-link" href="/analytics"><i class="bi bi-bar-chart-fill me-2"></i> Analytics</a></li>
                        <li class="nav-item mt-3"><a class="nav-link" href="/ai-advisor"><i class="bi bi-stars me-2 text-gold"></i> AI Advisor</a></li>
                    </ul>
                </div>
            </nav>

            <!-- Main Content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
                    <h1 class="h3 fw-bold">Manage Categories</h1>
                    <button class="btn btn-primary rounded-pill shadow-sm px-4" data-bs-toggle="modal" data-bs-target="#categoryModal"><i class="bi bi-plus-circle me-1"></i> New Category</button>
                </div>

                <% 
                    const expenseCats = categories.filter(c => c.type === 'EXPENSE');
                    const incomeCats = categories.filter(c => c.type === 'INCOME');
                %>

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <h5 class="fw-bold text-dark mb-3">Expense Categories</h5>
                        <ul class="list-group rounded-4 shadow-sm">
                            <% expenseCats.forEach(c => { %>
                                <li class="list-group-item d-flex justify-content-between align-items-center p-3 border-0 border-bottom">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white me-3" style="width: 40px; height: 40px; background-color: <%= c.color %>">
                                            <i class="bi <%= c.icon %>"></i>
                                        </div>
                                        <span class="fw-medium"><%= c.name %></span>
                                    </div>
                                    <% if (c.user_id) { %>
                                        <form action="/categories/delete" method="POST" class="m-0" onsubmit="return confirm('Delete this custom category?');">
                                            <input type="hidden" name="categoryId" value="<%= c.id %>">
                                            <button type="submit" class="btn btn-sm btn-outline-danger border-0"><i class="bi bi-trash"></i></button>
                                        </form>
                                    <% } else { %>
                                        <span class="badge bg-light text-muted border">Default</span>
                                    <% } %>
                                </li>
                            <% }) %>
                        </ul>
                    </div>

                    <div class="col-md-6 mb-4">
                        <h5 class="fw-bold text-dark mb-3">Income Categories</h5>
                        <ul class="list-group rounded-4 shadow-sm">
                            <% incomeCats.forEach(c => { %>
                                <li class="list-group-item d-flex justify-content-between align-items-center p-3 border-0 border-bottom">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white me-3" style="width: 40px; height: 40px; background-color: <%= c.color %>">
                                            <i class="bi <%= c.icon %>"></i>
                                        </div>
                                        <span class="fw-medium"><%= c.name %></span>
                                    </div>
                                    <% if (c.user_id) { %>
                                        <form action="/categories/delete" method="POST" class="m-0" onsubmit="return confirm('Delete this custom category?');">
                                            <input type="hidden" name="categoryId" value="<%= c.id %>">
                                            <button type="submit" class="btn btn-sm btn-outline-danger border-0"><i class="bi bi-trash"></i></button>
                                        </form>
                                    <% } else { %>
                                        <span class="badge bg-light text-muted border">Default</span>
                                    <% } %>
                                </li>
                            <% }) %>
                        </ul>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="categoryModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <form action="/categories" method="POST">
                    <div class="modal-header border-bottom-0"><h5 class="modal-title fw-bold">Add Custom Category</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small text-muted">Category Name</label>
                            <input type="text" class="form-control bg-light" name="name" required placeholder="e.g. Gym, Freelance">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-muted">Type</label>
                            <select class="form-select bg-light" name="type" required>
                                <option value="EXPENSE">Expense</option>
                                <option value="INCOME">Income</option>
                            </select>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label small text-muted">Color</label>
                                <input type="color" class="form-control form-control-color w-100" name="color" value="#ffd700" title="Choose your color">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label small text-muted">Bootstrap Icon Class</label>
                                <input type="text" class="form-control bg-light" name="icon" placeholder="e.g. bi-star-fill" value="bi-star-fill">
                                <div class="form-text small"><a href="https://icons.getbootstrap.com/" target="_blank">Find icons here</a></div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-top-0 pt-0"><button type="submit" class="btn btn-primary w-100 rounded-pill fw-medium">Create Category</button></div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
