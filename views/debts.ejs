<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Debt & Loan Tracker - SpendWise</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm border-bottom sticky-top">
        <div class="container-fluid px-4"><a class="navbar-brand fw-bold text-primary d-flex align-items-center" href="/dashboard"><i class="bi bi-wallet2 fs-4 me-2 text-gold"></i> SpendWise</a></div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse border-end" id="sidebarMenu">
                <div class="position-sticky pt-4 px-3">
                    <ul class="nav flex-column gap-1">
                        <li class="nav-item"><a class="nav-link" href="/dashboard"><i class="bi bi-grid-1x2-fill me-2"></i> Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" href="/transactions"><i class="bi bi-list-columns-reverse me-2"></i> Transactions</a></li>
                        <li class="nav-item"><a class="nav-link" href="/budgets"><i class="bi bi-pie-chart-fill me-2"></i> Budgets</a></li>
                        <li class="nav-item"><a class="nav-link" href="/savings"><i class="bi bi-piggy-bank-fill me-2"></i> Savings Goals</a></li>
                        <li class="nav-item"><a class="nav-link" href="/subscriptions"><i class="bi bi-arrow-repeat me-2"></i> Subscriptions</a></li>
                        <li class="nav-item"><a class="nav-link" href="/split-bills"><i class="bi bi-people-fill me-2"></i> Bill Splitter</a></li>
                        <li class="nav-item"><a class="nav-link active" href="/debts"><i class="bi bi-bank me-2"></i> Debt Tracker</a></li>
                        <li class="nav-item"><a class="nav-link" href="/categories"><i class="bi bi-tags-fill me-2"></i> Categories</a></li>
                        <li class="nav-item"><a class="nav-link" href="/analytics"><i class="bi bi-bar-chart-fill me-2"></i> Analytics</a></li>
                        <li class="nav-item mt-3"><a class="nav-link" href="/ai-advisor"><i class="bi bi-stars me-2 text-gold"></i> AI Advisor</a></li>
                    </ul>
                </div>
            </nav>

            <!-- Main Content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
                    <h1 class="h3 fw-bold">Debt & Loan Tracker</h1>
                    <button class="btn btn-primary rounded-pill shadow-sm px-4" data-bs-toggle="modal" data-bs-target="#debtModal"><i class="bi bi-plus-circle me-1"></i> Add Borrowing</button>
                </div>

                <% 
                    const activeDebts = debts.filter(d => d.status === 'ACTIVE');
                    const paidDebts = debts.filter(d => d.status === 'PAID');
                %>

                <h5 class="fw-bold mb-3 text-dark">Active Borrowings <span class="badge bg-danger rounded-pill"><%= activeDebts.length %></span></h5>
                <div class="row g-4 mb-5">
                    <% if (activeDebts.length === 0) { %>
                        <div class="col-12 text-center py-4 border rounded-4 bg-white shadow-sm">
                            <i class="bi bi-emoji-smile text-muted fs-1 mb-2"></i>
                            <p class="text-muted mb-0">You are debt free! Awesome.</p>
                        </div>
                    <% } %>
                    <% activeDebts.forEach(d => { 
                        let remaining = d.total_amount - d.amount_paid;
                        let progress = (d.amount_paid / d.total_amount) * 100;
                    %>
                        <div class="col-12 col-xl-6">
                            <div class="card border-0 shadow-sm rounded-4 p-3 dashboard-card border-start border-4 border-danger">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between mb-2">
                                        <h5 class="fw-bold text-dark mb-0">Owed to: <%= d.lender_name %></h5>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-sm btn-outline-success rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#payModal" onclick="setDebtId('<%= d.id %>')"><i class="bi bi-cash-stack me-1"></i> Pay</button>
                                            <form action="/debts/delete" method="POST" class="m-0" onsubmit="return confirm('Delete this record?');">
                                                <input type="hidden" name="debtId" value="<%= d.id %>">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary rounded-circle"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </div>
                                    </div>
                                    <% if(d.due_date) { %>
                                        <p class="text-danger small mb-3"><i class="bi bi-calendar-x me-1"></i> Due by: <%= formatDate(d.due_date) %></p>
                                    <% } %>
                                    
                                    <div class="d-flex justify-content-between mb-1 mt-3">
                                        <span class="fw-bold text-danger fs-5">Remaining: <%= formatCurrency(remaining) %></span>
                                        <span class="text-muted">Total: <%= formatCurrency(d.total_amount) %></span>
                                    </div>
                                    <div class="progress rounded-pill bg-light" style="height: 10px;">
                                        <div class="progress-bar bg-danger rounded-pill" style="width: <%= progress %>%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <% if (paidDebts.length > 0) { %>
                <h5 class="fw-bold mb-3 text-success">Cleared Debts 🏆</h5>
                <div class="row g-4 mb-4">
                    <% paidDebts.forEach(d => { %>
                        <div class="col-12 col-xl-4 col-md-6">
                            <div class="card border-success border-2 shadow-sm rounded-4 p-3 dashboard-card bg-white opacity-75">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <h5 class="fw-bold text-success"><i class="bi bi-check-circle-fill me-2"></i><%= d.lender_name %></h5>
                                        <form action="/debts/delete" method="POST" class="m-0" onsubmit="return confirm('Delete this record?');">
                                            <input type="hidden" name="debtId" value="<%= d.id %>">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                    <p class="text-muted small mt-2 mb-0">Total Repaid: <span class="fw-bold"><%= formatCurrency(d.total_amount) %></span></p>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
                <% } %>
            </main>
        </div>
    </div>

    <!-- Modals -->
    <div class="modal fade" id="debtModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <form action="/debts" method="POST">
                    <div class="modal-header border-bottom-0"><h5 class="modal-title fw-bold">Add Borrowing</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                    <div class="modal-body">
                        <input type="hidden" name="action" value="create">
                        <input type="text" class="form-control mb-3 bg-light" name="lenderName" placeholder="Who did you borrow from? (e.g. Bank, Friend's Name)" required>
                        <div class="mb-3">
                            <label class="form-label small text-muted">Total Amount Borrowed (₹)</label>
                            <input type="number" step="0.01" class="form-control form-control-lg bg-light" name="totalAmount" placeholder="e.g. 5000" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-muted">Due Date (Optional)</label>
                            <input type="date" class="form-control bg-light" name="dueDate">
                        </div>
                    </div>
                    <div class="modal-footer border-top-0 pt-0"><button type="submit" class="btn btn-primary w-100 rounded-pill fw-medium">Save Record</button></div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="payModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <form action="/debts" method="POST">
                    <div class="modal-header border-bottom-0"><h5 class="modal-title fw-bold">Record Repayment</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                    <div class="modal-body">
                        <input type="hidden" name="action" value="pay">
                        <input type="hidden" name="debtId" id="payDebtId">
                        <input type="number" class="form-control form-control-lg bg-light" name="amount" placeholder="Amount you paid back (₹)" required>
                    </div>
                    <div class="modal-footer border-top-0 pt-0"><button type="submit" class="btn btn-success w-100 rounded-pill fw-medium">Record Payment</button></div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function setDebtId(id) { document.getElementById('payDebtId').value = id; }
    </script>
</body>
</html>
