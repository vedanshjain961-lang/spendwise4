<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Advisor - SpendWise</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <style>
        .ai-chat-box {
            background-color: #f8f9fa;
            border-radius: 1rem;
            padding: 1.5rem;
            min-height: 300px;
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
        }
        .ai-chat-box p { margin-bottom: 1rem; }
        .ai-chat-box ul { margin-bottom: 1rem; padding-left: 1.5rem; }
        .ai-chat-box h1, .ai-chat-box h2, .ai-chat-box h3 { font-size: 1.2rem; font-weight: bold; margin-top: 1.5rem; margin-bottom: 0.5rem; }
        .sparkle-text {
            background: -webkit-linear-gradient(45deg, #FF33A8, #9033FF, #335BFF);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: bold;
        }
    </style>
</head>
<body class="bg-light">
    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm border-bottom sticky-top">
        <div class="container-fluid px-4"><a class="navbar-brand fw-bold text-primary d-flex align-items-center" href="/dashboard"><i class="bi bi-wallet2 fs-4 me-2"></i> SpendWise</a></div>
    </nav>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block bg-white sidebar collapse border-end" id="sidebarMenu">
                <div class="position-sticky pt-4 px-3">
                    <ul class="nav flex-column gap-1">
                        <li class="nav-item"><a class="nav-link" href="/dashboard"><i class="bi bi-grid-1x2-fill me-2"></i> Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" href="/transactions"><i class="bi bi-list-columns-reverse me-2"></i> Transactions</a></li>
                        <li class="nav-item"><a class="nav-link" href="/budgets"><i class="bi bi-pie-chart-fill me-2"></i> Budgets</a></li>
                        <li class="nav-item"><a class="nav-link" href="/savings"><i class="bi bi-piggy-bank-fill me-2"></i> Savings Goals</a></li>
                        <li class="nav-item"><a class="nav-link" href="/subscriptions"><i class="bi bi-arrow-repeat me-2"></i> Subscriptions</a></li>
                        <li class="nav-item"><a class="nav-link" href="/split-bills"><i class="bi bi-people-fill me-2"></i> Bill Splitter</a></li>
                        <li class="nav-item"><a class="nav-link" href="/debts"><i class="bi bi-bank me-2"></i> Debt Tracker</a></li>
                        <li class="nav-item"><a class="nav-link" href="/categories"><i class="bi bi-tags-fill me-2"></i> Categories</a></li>
                        <li class="nav-item"><a class="nav-link" href="/analytics"><i class="bi bi-bar-chart-fill me-2"></i> Analytics</a></li>
                        <li class="nav-item mt-3"><a class="nav-link active" href="/ai-advisor"><i class="bi bi-stars me-2 text-gold"></i> AI Advisor</a></li>
                    </ul>
                </div>
            </nav>
            <!-- Main Content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
                    <h1 class="h3 fw-bold sparkle-text"><i class="bi bi-stars"></i> AI Financial Advisor</h1>
                </div>
                
                <div class="row">
                    <div class="col-12 col-xl-8">
                        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 dashboard-card">
                            <h5 class="fw-bold mb-3">Get Personalized Spending Insights</h5>
                            <p class="text-muted">Our AI analyzes your recent transactions, budgets, and savings goals to give you personalized advice on where you can cut back and save more money this month.</p>
                            
                            <button id="analyzeBtn" class="btn btn-primary rounded-pill px-4 py-2 mt-2 fw-medium" onclick="getAdvice()">
                                <i class="bi bi-magic me-2"></i> Analyze My Finances
                            </button>
                        </div>
                    </div>
                </div>

                <div class="row d-none" id="resultsRow">
                    <div class="col-12 col-xl-8">
                        <div class="card border-0 shadow-sm rounded-4 p-4 dashboard-card">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px;">
                                    <i class="bi bi-robot fs-5"></i>
                                </div>
                                <h5 class="fw-bold mb-0">AI Assessment</h5>
                            </div>
                            <div id="aiResponse" class="ai-chat-box">
                                <div class="text-center mt-5">
                                    <div class="spinner-border text-primary" role="status"></div>
                                    <p class="mt-3 text-muted">Analyzing your transactions and budgets...</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function getAdvice() {
            const btn = document.getElementById('analyzeBtn');
            const results = document.getElementById('resultsRow');
            const resp = document.getElementById('aiResponse');
            
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Analyzing...';
            results.classList.remove('d-none');
            resp.innerHTML = '<div class="text-center mt-5"><div class="spinner-border text-primary" role="status"></div><p class="mt-3 text-muted">Analyzing your transactions and budgets...</p></div>';
            
            fetch('/api/ai-advisor', { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if(data.error) {
                    resp.innerHTML = `<div class="alert alert-danger">${data.error}</div>`;
                } else {
                    resp.innerHTML = marked.parse(data.advice);
                }
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-magic me-2"></i> Refresh Analysis';
            })
            .catch(err => {
                resp.innerHTML = '<div class="alert alert-danger">Failed to communicate with AI server.</div>';
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-magic me-2"></i> Try Again';
            });
        }
    </script>
</body>
</html>
